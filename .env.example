# ============================================================
# Controlitix — single-host deployment env template
# Copy to `.env` and fill in real values before `docker compose up`.
# ============================================================

# ---------------- Gateway (nginx) ----------------
# Public HTTP port exposed by the gateway (single entry point).
GATEWAY_HTTP_PORT=80

# ---------------- PostgreSQL + TimescaleDB ----------------
# Owns schemas: public, devices, tags, history (TimescaleDB), alarms, auth.
# Single instance (per ADR: deployment = 1 host per object, Docker Compose).
POSTGRES_USER=controlitix
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=controlitix
# Host port for psql access from host machine. Set to 127.0.0.1:5432 mapping
# in compose if you want to lock it to localhost.
POSTGRES_PORT=5432

# ---------------- Kafka (KRaft, single broker) ----------------
# Generate once with: docker run --rm bitnami/kafka:3.7 kafka-storage.sh random-uuid
# Must be a valid base64-encoded UUID (22 chars). Persisted across restarts.
KAFKA_KRAFT_CLUSTER_ID=replace_with_kafka_kraft_uuid
# External listener — for tools (kafka-ui, kcat) running on the host.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9094

# ---------------- ms-editor (Go) ----------------
MS_EDITOR_LOG_LEVEL=info
# Connection string used by ms-editor and by the goose migrate sidecar.
# Hostname `postgres` resolves inside the compose network.
MS_EDITOR_DATABASE_URL=postgres://controlitix:change_me_postgres@postgres:5432/controlitix?sslmode=disable
# Comma-separated list of brokers (internal listener).
MS_EDITOR_KAFKA_BROKERS=kafka:9092
MS_EDITOR_KAFKA_TOPIC=config.changed

# ---------------- editor-ui (React) ----------------
# Baked into the Vite bundle at build time via VITE_API_URL.
# Default `/api` works because the gateway proxies /api/ → ms-editor.
EDITOR_UI_API_URL=/api

# ============================================================
# Reserved for future services (not yet wired up)
# ============================================================
# REDIS_URL=redis://redis:6379/0           # ms-viewer realtime cache
# MS_AUTH_DATABASE_URL=...                  # ms-auth (planned)
# MS_POLL_DATABASE_URL=...                  # ms-poll (planned)
# MS_VIEWER_DATABASE_URL=...                # ms-viewer (planned)
