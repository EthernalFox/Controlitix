# =============================================================
# Controlitix - полный стек (docker compose up --build)
# —копировать в .env и заполнить секреты
# =============================================================

# ---- PostgreSQL ------------------------------------------------
POSTGRES_USER=controlitix
POSTGRES_PASSWORD=controlitix
POSTGRES_DB=controlitix
POSTGRES_PORT=5432

# ---- Kafka KRaft -----------------------------------------------
# —генерировать: docker run --rm bitnamilegacy/kafka:3.7.0 kafka-storage.sh random-uuid
KAFKA_KRAFT_CLUSTER_ID=replace_me_with_uuid
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9094

# ---- ms-editor -------------------------------------------------
MS_EDITOR_DATABASE_URL=postgres://controlitix:controlitix@postgres:5432/controlitix?sslmode=disable
MS_EDITOR_LOG_LEVEL=info
MS_EDITOR_KAFKA_BROKERS=kafka:9092
MS_EDITOR_KAFKA_TOPIC=config.changed

# ---- ms-auth ---------------------------------------------------
MS_AUTH_DATABASE_URL=postgres://controlitix:controlitix@postgres:5432/controlitix?sslmode=disable
MS_AUTH_LOG_LEVEL=info
MS_AUTH_KAFKA_BROKERS=kafka:9092
MS_AUTH_KAFKA_AUDIT_TOPIC=audit.logs

# —генерировать pepper: openssl rand -base64 48
MS_AUTH_PASSWORD_PEPPER=replace_me_with_base64_48bytes

# —генерировать ключ: openssl genrsa 2048 | base64 -w 0
MS_AUTH_JWT_PRIVATE_KEY=replace_me_with_base64_encoded_pem

MS_AUTH_JWT_KEY_ID=default
MS_AUTH_JWT_ISSUER=controlitix-auth
MS_AUTH_JWT_AUDIENCE_USER=controlitix-api

# ---- ms-poll ---------------------------------------------------
# „итает схему ms-editor, своих миграций нет
MS_POLL_DATABASE_URL=postgres://controlitix:controlitix@postgres:5432/controlitix?sslmode=disable
MS_POLL_LOG_LEVEL=info
MS_POLL_KAFKA_BROKERS=kafka:9092
MS_POLL_KAFKA_CONFIG_TOPIC=config.changed
MS_POLL_KAFKA_TAG_VALUES_TOPIC=tags.values

# ---- ms-viewer -------------------------------------------------
MS_VIEWER_DATABASE_URL=postgres://controlitix:controlitix@postgres:5432/controlitix?sslmode=disable
MS_VIEWER_REDIS_URL=redis://redis:6379
MS_VIEWER_KAFKA_BROKERS=kafka:9092
MS_VIEWER_JWKS_URL=http://ms-auth:8083/jwks
MS_VIEWER_JWT_ISSUER=controlitix-auth
MS_VIEWER_JWT_AUDIENCE_USER=controlitix-api
MS_VIEWER_LOG_LEVEL=info

# ќпционально: Telegram-уведомлени€ (оставить пустым чтобы отключить)
TELEGRAM_BOT_TOKEN=

# ---- Gateway ---------------------------------------------------
GATEWAY_HTTP_PORT=80

# ---- Frontend --------------------------------------------------
EDITOR_UI_API_URL=/api
VIEWER_UI_API_URL=/api/viewer
VIEWER_UI_WS_URL=/api/viewer/ws

VITE_VIEWER_UI_URL=http://localhost:5174
